#!name=Google Generate_204 本地返回204
#!desc=本地拦截 clients3.google.com/generate_204 并返回 HTTP 204
#!icon=https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1006.png

[Script]
http-request ^https?:\/\/clients3\.google\.com\/generate_204(?:\?.*)?$ script-path=https://raw.githubusercontent.com/takoyakiwhite/asoul_mirror/main/google204.js, tag=GoogleGenerate204

[MITM]
hostname = clients3.google.com

