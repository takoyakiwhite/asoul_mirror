#!name=网易云音乐
#!desc=网易云音乐全面净化，可自定义界面样式。
#!author=RuCu6[https://github.com/RuCu6], Keywos[https://github.com/Keywos], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/NeteaseMusic.png
#!openUrl=https://apps.apple.com/app/id590338362
#!tag=去广告, 解锁会员
#!loon_version=3.5.0(975)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-06-26 12:00

[Argument]
Music163_VIP_Shared=switch,"false","true",tag = 启用[共享会员], desc = 是否启用网易云音乐共享会员
Cookie=input, "",tag = Cookie, desc = 请填写Cookie值
MConfigInfo=input, "",tag = MConfigInfo ,desc = 请填写MConfigInfo值
UserAgent=input, "",tag = UserAgent, desc = 请填写UserAgent值

[Rule]
DOMAIN,iadmat.nosdn.127.net,REJECT
DOMAIN,iadmatapk.nosdn.127.net,REJECT
DOMAIN,iadmusicmat.music.126.net,REJECT
DOMAIN,iadmusicmatvideo.music.126.net,REJECT
DOMAIN,ipv4.music.163.com,REJECT
DOMAIN,ipv6.music.163.com,REJECT

[Script]
# 播放会员歌曲
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/(?:v1\/artist\/top\/song|v3\/discovery\/recommend\/songs) script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]播放会员歌曲, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/v3\/song\/detail script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]播放会员歌曲, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/song\/(?:chorus|enhance\/|play\/|type\/detail\/get) script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]播放会员歌曲, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 播放器会员皮肤
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/playermode\/ script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]播放器会员皮肤, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 搜索结果会员歌曲
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/search\/(?:complex\/page|complex\/rec\/song\/get|song\/list\/page) script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]搜索结果会员歌曲, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 侧边栏会员等级
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/vipnewcenter\/app\/resource\/newaccountpage script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]侧边栏会员等级, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 歌单列表会员认证
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/(?:homepage\/|v6\/)?playlist\/(?!(?:delete|subscribe|unsubscribe)) script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]歌单列表会员认证, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 会员认证
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/vipauth\/app\/auth\/(soundquality\/)?query script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]会员认证, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

[MITM]
hostname = interface*.music.163.com, ipv4.music.163.com

