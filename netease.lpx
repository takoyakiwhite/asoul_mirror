#!name=网易云音乐
#!desc=网易云音乐共享会员 + 会员歌曲播放 + 搜索解锁 + 会员认证 + 播放器皮肤，自定义共享参数。
#!author=takoyakiwhite
#!icon=https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/NeteaseMusic.png
#!openUrl=https://apps.apple.com/app/id590338362
#!tag=网易云音乐, 去广告, 共享会员, VIP
#!loon_version=3.5.0(975)
#!homepage=https://github.com
#!date=2026-08-05

[Argument]
Music163_VIP_Shared = switch, "false", "true", tag=启用共享会员, desc=启用网易云音乐共享会员功能
Cookie = input, "", tag=Cookie, desc=填写共享账号 Cookie
MConfigInfo = input, "", tag=MConfigInfo, desc=填写共享账号 MConfigInfo
UserAgent = input, "", tag=UserAgent, desc=填写共享账号 User-Agent
ConfigURL = input, "", tag=远程配置地址, desc=共享配置 JSON 地址
ConfigUserAgent = input, "", tag=远程配置UA, desc=请求共享配置时使用的 User-Agent

[Rule]
# 广告域名
DOMAIN,iadmat.nosdn.127.net,REJECT
DOMAIN,iadmatapk.nosdn.127.net,REJECT
DOMAIN,iadmusicmat.music.126.net,REJECT
DOMAIN,iadmusicmatvideo.music.126.net,REJECT

# IPv4 / IPv6 直连
DOMAIN,ipv4.music.163.com,REJECT
DOMAIN,ipv6.music.163.com,REJECT

[Script]

# ===============================
# 网易云音乐共享会员
# ===============================

# 会员歌曲（每日推荐 / 歌手热门）
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/(?:v1\/artist\/top\/song|v3\/discovery\/recommend\/songs) script-path=https://raw.githubusercontent.com/takoyakiwhite/asoul_mirror/main/netease.js, timeout=20, tag=[网易云]会员歌曲, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 歌曲详情
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/v3\/song\/detail script-path=https://raw.githubusercontent.com/takoyakiwhite/asoul_mirror/main/netease.js, timeout=20, tag=[网易云]歌曲详情, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 播放相关
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/song\/(?:chorus|enhance\/|play\/|type\/detail\/get) script-path=https://raw.githubusercontent.com/takoyakiwhite/asoul_mirror/main/netease.js, timeout=20, tag=[网易云]播放接口, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 播放器皮肤
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/playermode\/ script-path=https://raw.githubusercontent.com/takoyakiwhite/asoul_mirror/main/netease.js, timeout=20, tag=[网易云]播放器皮肤, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 搜索结果
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/search\/(?:complex\/page|complex\/rec\/song\/get|song\/list\/page) script-path=https://raw.githubusercontent.com/takoyakiwhite/asoul_mirror/main/netease.js, timeout=20, tag=[网易云]搜索结果, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 侧边栏会员等级
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/vipnewcenter\/app\/resource\/newaccountpage script-path=https://raw.githubusercontent.com/takoyakiwhite/asoul_mirror/main/netease.js, timeout=20, tag=[网易云]会员等级, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 歌单会员认证
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/(?:homepage\/|v6\/)?playlist\/(?!(?:delete|subscribe|unsubscribe)) script-path=https://raw.githubusercontent.com/takoyakiwhite/asoul_mirror/main/netease.js, timeout=20, tag=[网易云]歌单认证, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# VIP认证
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/vipauth\/app\/auth\/(soundquality\/)?query script-path=https://raw.githubusercontent.com/takoyakiwhite/asoul_mirror/main/netease.js, timeout=20, tag=[网易云]VIP认证, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

[MITM]
hostname = interface*.music.163.com, ipv4.music.163.com
