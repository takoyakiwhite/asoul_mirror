#!name=网易云音乐
#!desc=网易云音乐全面净化，可自定义界面样式。
#!author=RuCu6[https://github.com/RuCu6], Keywos[https://github.com/Keywos], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/NeteaseMusic.png
#!openUrl=https://apps.apple.com/app/id590338362
#!tag=去广告, 解锁会员
#!loon_version=3.5.0(975)
#!homepage=https://loonlab.103516.xyz/Plugin/
#!date=2026-06-26 12:00

[Argument]
FX=switch,"false","true",tag = 隐藏[底部-发现], desc = 是否隐藏底部发现标签
MY=switch,"false","true",tag = 隐藏[底部-漫游], desc = 是否隐藏底部漫游标签
DT=switch,"false","true",tag = 隐藏[底部-笔记], desc = 是否隐藏底部笔记标签
GZ=switch,"false","true",tag = 隐藏[底部-关注], desc = 是否隐藏底部关注标签
PRGG=switch,"false","true",tag = 隐藏[首页-问候语], desc = 是否隐藏首页问候语
PRRK=switch,"false","true",tag = 隐藏[首页-排行榜], desc = 是否隐藏首页排行榜
PRDRD=switch,"false","true",tag = 隐藏[首页-每日推荐], desc = 是否隐藏首页每日推荐
PRSCVPT=switch,"false","true",tag = 隐藏[首页-推荐歌单], desc = 是否隐藏首页推荐歌单
PRST=switch,"false","true",tag = 隐藏[首页-最近常听], desc = 是否隐藏首页最近常听
PRRR=switch,"false","true",tag = 隐藏[首页-雷达歌单], desc = 是否隐藏首页雷达歌单
HMPR=switch,"false","true",tag = 隐藏[首页-音乐合伙人], desc = 是否隐藏首页音乐合伙人
PRMST=switch,"false","true",tag = 隐藏[首页-推荐专属歌单], desc = 是否隐藏首页专属歌单
PRCN=switch,"false","true",tag = 隐藏[首页-你的专属歌单], desc = 是否隐藏首页你的专属歌单
Music163_VIP_Shared=switch,"false","true",tag = 启用[共享会员], desc = 是否启用网易云音乐共享会员
Cookie=input, "",tag = Cookie, desc = 请填写Cookie值
MConfigInfo=input, "",tag = MConfigInfo ,desc = 请填写MConfigInfo值
UserAgent=input, "",tag = UserAgent, desc = 请填写UserAgent值

[Rule]
DOMAIN,iadmat.nosdn.127.net,REJECT
DOMAIN,iadmatapk.nosdn.127.net,REJECT
DOMAIN,iadmusicmat.music.126.net,REJECT
DOMAIN,iadmusicmatvideo.music.126.net,REJECT
DOMAIN,ipv4.music.163.com,REJECT
DOMAIN,ipv6.music.163.com,REJECT

[Rewrite]
^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/vip\/cashier\/tspopup\/get - reject-200

# 今日运势 商城 Beat专区 音乐收藏家 | type:ACTIVITY | 低至5.2折
^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/(?:delivery\/(batch-)?deliver|moment\/tab\/info\/|side-bar\/mini-program\/music-service\/account|yunbei\/account\/entrance\/) - reject-dict

# 播放页 歌名下方 乐迷团｜关注｜播放页提示｜音乐应用红点｜播放提示
^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/(?:community\/friends\/fans-group\/artist\/group\/|mine\/applet\/redpoint|music\/songshare\/text\/recommend\/|resniche\/position\/play\/new\/|resniche\/tspopup\/show|resource\/comments?\/musiciansaid\/|user\/sub\/artist) - reject-dict

^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/(?:ios\/version|mlivestream\/entrance\/playpage\/|link\/position\/show\/strategy|link\/scene\/show\/resource|v1\/content\/exposure\/comment\/banner\/) - reject-dict

^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/(?:activity\/bonus\/playpage\/time\/query|resource-exposure\/|search\/(?:chart\/|rcmd\/keyword\/|specialkeyword\/)) - reject-dict

# 主页播客推荐
^https:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/my\/podcast\/tab\/recommend - reject-dict

# ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/(?:batch|v\d\/resource\/comment\/floor\/get|homepage\/block\/page|link\/page\/rcmd\/(block\/resource\/multi\/refresh|resource\/show)|user\/follow\/users\/mixed\/get|link\/home\/framework\/tab|link\/position\/show\/resource|link\/page\/discovery\/resource\/show) header-del x-aeapi

^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/(?:batch|homepage\/block\/page|v\d\/(?:resource\/comment\/floor\/get|user\/detail\/\d+|discovery\/recommend\/songs|playlist\/detail)|link\/page\/rcmd\/(?:block\/resource\/multi\/refresh|resource\/show)|user\/follow\/users\/mixed\/get|link\/home\/framework\/tab|link\/position\/show\/resource|link\/page\/discovery\/resource\/show|mine\/(?:collect|rn)\/header\/info|vipnewcenter\/app\/resource\/newaccountpage|music-vip-membership\/(?:client|front)\/vip\/info|playlist\/privilege|search\/complex\/page) header-replace 'x-aeapi' 'false'

# 开屏广告
^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/(ocpc\/)?ad\/ - mock-response-body data-type=text

# 搜索页 搜索词 热搜卡片 猜你喜欢 我的应用下方提醒
^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/search\/default - mock-response-body data-type=text

[Script]

# 播放、推荐歌曲
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/(?:v1\/artist\/top\/song|v3\/discovery\/recommend\/songs) script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]播放会员歌曲, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 歌曲详情
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/v3\/song\/detail script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]歌曲详情, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 歌曲播放、权限、URL、详情
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/song\/(?:chorus|enhance(?:\/.*)?|play|type\/detail\/get|music\/detail\/get) script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]播放权限, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 新版歌曲权限（付费、试听、播放链接）
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/(?:privilege\/song\/(?:charge\/info|free\/trail\/query)|song\/privilege\/music\/url\/info\/query) script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]歌曲权限, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 会员信息
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/music-vip-membership\/client\/vip\/info script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]会员信息, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 音效（列表、首页、移动端）
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/usertool\/(?:sound(?:\/.*)?|home\/sound\/info)$ script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]音效, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 播放器会员皮肤
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/playermode\/ script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]播放器皮肤, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 搜索结果（歌曲/听书）
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/search\/(?:complex\/page|complex\/rec\/song\/get|song\/list\/page) script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]搜索结果, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 侧边栏会员等级
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/vipnewcenter\/app\/resource\/newaccountpage script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]会员等级, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 首页歌单、歌单详情
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/(?:homepage\/|v6\/)?playlist\/(?!(?:delete|subscribe|unsubscribe)) script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]歌单, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 会员模块（认证、权益、会员标识等）
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/vipauth\/app(?:\/.*)?(?:\?.*)?$ script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]会员模块, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 我的页面 VIP 图标
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/resniche\/mypage\/vip\/icon\/info\/get script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]VIP图标, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

# 试听歌曲权益
http-request ^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/(?:w|x)?eapi\/vipmall\/interest\/trialsong\/listen script-path=https://loon.103516.xyz/Script/NeteaseMusic/CloudMusicVIP.js, timeout=20, tag=[网易云音乐]试听权益, enable={Music163_VIP_Shared}, argument="[{Cookie},{MConfigInfo},{UserAgent}]"

[MITM]
hostname = interface*.music.163.com, ipv4.music.163.com

