#!name=网易云音乐解除海外限制
#!desc=解除网易云音乐海外版权限制，支持音源解锁与海外播放，可独立使用或与共享会员模块配合使用。
#!author=QuellaMC
#!icon=https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/NeteaseMusic.png
#!openUrl=https://apps.apple.com/app/id590338362
#!tag=网易云音乐, 音源解锁, 海外限制
#!loon_version=3.5.0(975)
#!homepage=https://github.com/QuellaMC/NeteaseUnlocker
#!date=2026-08-05

[Argument]

Music163_Unlock = switch, "false", "true", tag=解除海外限制, desc=启用网易云音乐解除海外限制功能

[Script]

# ===============================

# 网易云音乐解除海外限制

# ===============================

# 音源解锁（请求）

http-request ^https?:\/\/(ipv4|interface\d?|music)\.163\.com\/(?:w|x)?e?api\/.* script-path=https://raw.githubusercontent.com/QuellaMC/NeteaseUnlocker/main/js/unblock-netease-header.js, timeout=60, tag=[网易云]解除海外限制, enable={Music163_Unlock}

# 音源解锁（响应）

http-response ^https?:\/\/(ipv4|interface\d?|music)\.163\.com\/(?:w|x)?e?api\/.* script-path=https://raw.githubusercontent.com/QuellaMC/NeteaseUnlocker/main/js/unblock-netease.js, requires-body=true, timeout=60, tag=[网易云]解除海外限制, enable={Music163_Unlock}

[MITM]

hostname = music.163.com, ipv4.music.163.com, interface.music.163.com, interface1.music.163.com, interface2.music.163.com
