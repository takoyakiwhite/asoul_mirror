#!name=B站去P2P CDN
#!desc=屏蔽B站P2P CDN

[URL Rewrite]

# MCDN（任意路径、限定端口）
^https?:\/\/(?:[a-zA-Z0-9-]+)\.mcdn\.bilivideo\.(?:cn|net):(?:8000|8082|4483|9102)\/(.+) https://upos-sz-mirrorcos.bilivideo.com/$1 302

# PCDN（域名:4480）
^https?:\/\/.+:4480\/upgcxcode\/(.+) https://upos-sz-mirrorcos.bilivideo.com/upgcxcode/$1 302

# Akamai（任意路径）
^https?:\/\/upos-(?:hz|bstar1)-mirrorakam\.akamaized\.net\/(.+) https://upos-sz-mirrorcos.bilivideo.com/$1 302

# szbdyd（任意路径）
^https?:\/\/(?:[a-zA-Z0-9.-]+)\.szbdyd\.com(?:\:[0-9]+)?\/(.+) https://upos-sz-mirrorcos.bilivideo.com/$1 302

# mcdn + szbdyd（任意路径）
^https?:\/\/(?:[a-zA-Z0-9.-]+)\.mcdn\.bilivideo\.cn\.szbdyd\.com(?:\:[0-9]+)?\/(.+) https://upos-sz-mirrorcos.bilivideo.com/$1 302

# cn-* 节点（任意路径）
^https?:\/\/cn-.*\.bilivideo\.(?:com|cn)\/(.+) https://upos-sz-mirrorcos.bilivideo.com/$1 302

# upos-sz-302kodo（任意路径）
^https?:\/\/upos-sz-302kodo\.bilivideo\.(?:com|cn)\/(.+) https://upos-sz-mirrorcos.bilivideo.com/$1 302

# upos-sz-302ppio（任意路径）
^https?:\/\/upos-sz-302ppio\.bilivideo\.(?:com|cn)\/(.+) https://upos-sz-mirrorcos.bilivideo.com/$1 302

# nexusedgeio（任意路径）
^https?:\/\/[^\/]+\.nexusedgeio\.com\/(.+) https://upos-sz-mirrorcos.bilivideo.com/$1 302

# ahdohpiechei（任意路径）
^https?:\/\/[^\/]+\.ahdohpiechei\.com\/(.+) https://upos-sz-mirrorcos.bilivideo.com/$1 302

# mountaintoys（任意路径、限定端口）
^https?:\/\/[a-z0-9-]+\.edge\.mountaintoys\.cn:(?:4483|9102)\/(.+) https://upos-sz-mirrorcos.bilivideo.com/$1 302

# upos-sz-mirror14b（任意路径）
^https?:\/\/upos-sz-mirror14b\.bilivideo\.(?:com|cn)\/(.+) https://upos-sz-mirrorcos.bilivideo.com/$1 302

# ==========================
# IP
# ==========================

# IP（v1/resource）
^https?:\/\/\d+\.\d+\.\d+\.\d+:(?:8000|8082)\/v1\/resource\/(.+) https://upos-sz-mirrorcos.bilivideo.com/v1/resource/$1 302

# IP（upgcxcode）
^https?:\/\/\d+\.\d+\.\d+\.\d+:\d+\/upgcxcode\/(.+) https://upos-sz-mirrorcos.bilivideo.com/upgcxcode/$1 302

[MITM]
hostname = %APPEND% *.bilivideo.com, *.bilivideo.cn, *.mcdn.bilivideo.cn, *.mcdn.bilivideo.cn:*, *.mcdn.bilivideo.net, *.mcdn.bilivideo.net:*, *.szbdyd.com, *.szbdyd.com:*, *.mountaintoys.cn, *.mountaintoys.cn:*, *.nexusedgeio.com, *.nexusedgeio.com:*, *.ahdohpiechei.com, *.ahdohpiechei.com:*, upos-sz-mirror*bstar1.bilivideo.com, upos-*-mirrorakam.akamaized.net
