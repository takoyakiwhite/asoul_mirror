#!name=B站去P2P CDN
#!desc=屏蔽B站P2P CDN

[Rule]
DOMAIN-KEYWORD,pcdn.biliapi.net,REJECT
DOMAIN-KEYWORD,hw-sh-pcdn,REJECT
DOMAIN-KEYWORD,ali-bj-pcdn,REJECT

[URL Rewrite]
# ==========================
^https?:\/\/[a-zA-Z0-9-]+\.mcdn\.bilivideo\.(?:cn|net)(?::[0-9]+)?\/(?:v1\/resource\/)?upgcxcode\/(.+) http://upos-sz-mirrorali.bilivideo.com/upgcxcode/$1 302
# 域名:4480
^https?:\/\/[^\/]+:4480\/(?:v1\/resource\/)?upgcxcode\/(.+) http://upos-sz-mirrorali.bilivideo.com/upgcxcode/$1 302
# IP:8000/8082
^https?:\/\/(?:\d{1,3}\.){3}\d{1,3}(?::(?:8000|8082))?\/(?:v1\/resource\/)?upgcxcode\/(.+) http://upos-sz-mirrorali.bilivideo.com/upgcxcode/$1 302
# Akamai
# ^https?:\/\/upos-(?:hz|bstar1)-mirrorakam\.akamaized\.net\/(?:v1\/resource\/)?upgcxcode\/(.+) http://upos-sz-mirrorali.bilivideo.com/upgcxcode/$1 302
# mirror14b
^https?:\/\/upos-sz-mirror14b\.bilivideo\.(?:com|cn)\/(?:v1\/resource\/)?upgcxcode\/(.+) http://upos-sz-mirrorali.bilivideo.com/upgcxcode/$1 302
# cn-* 节点
^https?:\/\/cn-[a-zA-Z0-9.-]+\.bilivideo\.(?:com|cn)\/(?:v1\/resource\/)?upgcxcode\/(.+) http://upos-sz-mirrorali.bilivideo.com/upgcxcode/$1 302
# 302kodo
^https?:\/\/upos-sz-302kodo\.bilivideo\.(?:com|cn)\/(?:v1\/resource\/)?upgcxcode\/(.+) http://upos-sz-mirrorali.bilivideo.com/upgcxcode/$1 302
# 302ppio
^https?:\/\/upos-sz-302ppio\.bilivideo\.(?:com|cn)\/(?:v1\/resource\/)?upgcxcode\/(.+) http://upos-sz-mirrorali.bilivideo.com/upgcxcode/$1 302
# szbdyd
^https?:\/\/[a-zA-Z0-9.-]+\.szbdyd\.com(?::\d+)?\/(?:v1\/resource\/)?upgcxcode\/(.+) http://upos-sz-mirrorali.bilivideo.com/upgcxcode/$1 302
# mcdn + szbdyd
^https?:\/\/[a-zA-Z0-9.-]+\.mcdn\.bilivideo\.cn\.szbdyd\.com(?::\d+)?\/(?:v1\/resource\/)?upgcxcode\/(.+) http://upos-sz-mirrorali.bilivideo.com/upgcxcode/$1 302
# mountaintoys
^https?:\/\/[a-zA-Z0-9-]+\.edge\.mountaintoys\.cn(?::(?:4483|9102))?\/(?:v1\/resource\/)?upgcxcode\/(.+) http://upos-sz-mirrorali.bilivideo.com/upgcxcode/$1 302
# nexusedgeio
^https?:\/\/[a-zA-Z0-9.-]+\.nexusedgeio\.com\/(?:v1\/resource\/)?upgcxcode\/(.+) http://upos-sz-mirrorali.bilivideo.com/upgcxcode/$1 302
# ahdohpiechei
^https?:\/\/[a-zA-Z0-9.-]+\.ahdohpiechei\.com\/(?:v1\/resource\/)?upgcxcode\/(.+) http://upos-sz-mirrorali.bilivideo.com/upgcxcode/$1 302
# yirujs
^https?:\/\/[a-zA-Z0-9-]+\.yirujs\.com\/(?:v1\/resource\/)?upgcxcode\/(.+) http://upos-sz-mirrorali.bilivideo.com/upgcxcode/$1 302

[MITM]
hostname = %APPEND% *.bilivideo.com, *.bilivideo.cn, *.szbdyd.com, *.mountaintoys.cn, *.nexusedgeio.com, *.ahdohpiechei.com, upos-hz-mirrorakam.akamaized.net, upos-bstar1-mirrorakam.akamaized.net
