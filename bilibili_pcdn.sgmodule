#!name=B站去P2P CDN
#!desc=屏蔽B站P2P CDN

[URL Rewrite]

# 普通 CDN（upgcxcode）
^https?:\/\/.+\.bilivideo\.com\/upgcxcode\/(.+) https://upos-sz-mirrorcos.bilivideo.com/upgcxcode/$1 302

# MCDN（v1/resource）
^https?:\/\/[adbcefxy0-9]+\.mcdn\.bilivideo\.(cn|net)(:(8000|8082))?\/v1\/resource\/(.+) https://upos-sz-mirrorcos.bilivideo.com/v1/resource/$2 302

# MCDN（upgcxcode）
^https?:\/\/[adbcefxy0-9]+\.mcdn\.bilivideo\.(cn|net)(:(4483|9102))?\/upgcxcode\/(.+) https://upos-sz-mirrorcos.bilivideo.com/upgcxcode/$2 302

# PCDN（域名:4480）
^https?:\/\/(.+):4480\/upgcxcode\/(.+) https://upos-sz-mirrorcos.bilivideo.com/upgcxcode/$2 302

# PCDN（IP:8000/8082）
^https?:\/\/([0-9]{1,3}\.){3}[0-9]{1,3}(:(8000|8082))?\/v1\/resource\/(.+) https://upos-sz-mirrorcos.bilivideo.com/v1/resource/$4 302

# Akamai
^https?:\/\/upos-(hz|bstar1)-mirrorakam\.akamaized\.net\/upgcxcode\/(.+) https://upos-sz-mirrorcos.bilivideo.com/upgcxcode/$2 302

# ==========================
# 补充规则（BiliUniverse 原版未覆盖）
# ==========================

# szbdyd 域名（第二种 P2P）
^https?:\/\/([a-zA-Z0-9.-]+)\.szbdyd\.com(\:[0-9]+)?\/(.+) https://upos-sz-mirrorcos.bilivideo.com/$3 302

# 直接 IP:任意端口（v1/resource）
^https?:\/\/\d+\.\d+\.\d+\.\d+:\d+\/v1\/resource\/(.+) https://upos-sz-mirrorcos.bilivideo.com/v1/resource/$1 302

# 直接 IP:任意端口（upgcxcode）
^https?:\/\/\d+\.\d+\.\d+\.\d+:\d+\/upgcxcode\/(.+) https://upos-sz-mirrorcos.bilivideo.com/upgcxcode/$1 302

# mcdn + szbdyd 组合域名
^https?:\/\/([a-zA-Z0-9.-]+)\.mcdn\.bilivideo\.cn\.szbdyd\.com(\:[0-9]+)?\/(.+) https://upos-sz-mirrorcos.bilivideo.com/$3 302

[MITM]
hostname = %APPEND% *.bilivideo.com, *.mcdn.bilivideo.cn, *.mcdn.bilivideo.cn:*, *.mcdn.bilivideo.net, *.mcdn.bilivideo.net:*, *.szbdyd.com, *.szbdyd.com:*, upos-sz-mirror*bstar1.bilivideo.com, upos-*-mirrorakam.akamaized.net
