#!name=B站去P2P CDN
#!desc=屏蔽B站P2P CDN

[Rule]
DOMAIN-SUFFIX,pcdn.biliapi.net,REJECT
DOMAIN-KEYWORD,hw-sh-pcdn,REJECT
DOMAIN-KEYWORD,ali-bj-pcdn,REJECT

[URL Rewrite]
# mcdn
^(https?):\/\/[a-zA-Z0-9-]+\.mcdn\.bilivideo\.(?:cn|net)(?::[0-9]+)?\/(?:v1\/resource\/)?upgcxcode\/(.+) $1://upos-sz-mirrorali.bilivideo.com/upgcxcode/$2 302
# 域名:4480
^(https?):\/\/[^\/]+:4480\/(?:v1\/resource\/)?upgcxcode\/(.+) $1://upos-sz-mirrorali.bilivideo.com/upgcxcode/$2 302
# IP:8000/8082
^(https?):\/\/(?:\d{1,3}\.){3}\d{1,3}(?::(?:8000|8082))?\/(?:v1\/resource\/)?upgcxcode\/(.+) $1://upos-sz-mirrorali.bilivideo.com/upgcxcode/$2 302
# 所有官方 upos-*、cn-*（排除 upos-sz-mirrorali）
^(https?):\/\/(?!(?:upos-[^.]*mirrorali(?:[a-zA-Z0-9-]+)?)\.bilivideo\.(?:com|cn))(?:upos|cn)-[A-Za-z0-9.-]+\.bilivideo\.(?:com|cn)(?::\d+)?\/(?:v1\/resource\/)?upgcxcode\/(.+) $1://upos-sz-mirrorali.bilivideo.com/upgcxcode/$2 302
# szbdyd
^(https?):\/\/[a-zA-Z0-9.-]+\.szbdyd\.com(?::\d+)?\/(?:v1\/resource\/)?upgcxcode\/(.+) $1://upos-sz-mirrorali.bilivideo.com/upgcxcode/$2 302
# mcdn + szbdyd
^(https?):\/\/[a-zA-Z0-9.-]+\.mcdn\.bilivideo\.cn\.szbdyd\.com(?::\d+)?\/(?:v1\/resource\/)?upgcxcode\/(.+) $1://upos-sz-mirrorali.bilivideo.com/upgcxcode/$2 302
# mountaintoys
^(https?):\/\/[a-zA-Z0-9-]+\.edge\.mountaintoys\.cn(?::(?:4483|9102))?\/(?:v1\/resource\/)?upgcxcode\/(.+) $1://upos-sz-mirrorali.bilivideo.com/upgcxcode/$2 302
# nexusedgeio
^(https?):\/\/[a-zA-Z0-9.-]+\.nexusedgeio\.com\/(?:v1\/resource\/)?upgcxcode\/(.+) $1://upos-sz-mirrorali.bilivideo.com/upgcxcode/$2 302
# ahdohpiechei
^(https?):\/\/[a-zA-Z0-9.-]+\.ahdohpiechei\.com\/(?:v1\/resource\/)?upgcxcode\/(.+) $1://upos-sz-mirrorali.bilivideo.com/upgcxcode/$2 302
# yirujs
^(https?):\/\/[a-zA-Z0-9-]+\.yirujs\.com\/(?:v1\/resource\/)?upgcxcode\/(.+) $1://upos-sz-mirrorali.bilivideo.com/upgcxcode/$2 302
# 兼容 os=mcdn
^(https?):\/\/[^\/]+\/(?:v\d+\/resource\/)?upgcxcode\/([^?]+)\?(?:.*&)?os=mcdn(?:&.*)?$ $1://upos-sz-mirrorali.bilivideo.com/upgcxcode/$2 302

[MITM]
hostname = %APPEND% *.bilivideo.com, *.bilivideo.cn, *.szbdyd.com, *.mountaintoys.cn, *.nexusedgeio.com, *.ahdohpiechei.com, upos-hz-mirrorakam.akamaized.net, upos-bstar1-mirrorakam.akamaized.net
