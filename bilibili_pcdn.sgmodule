#!name=B站去P2P CDN
#!desc=屏蔽B站P2P CDN
#!system=ios

[Rule]

# ==========================
# MCDN
# ==========================

URL-REGEX,^https?:\/\/[a-zA-Z0-9-]+\.mcdn\.bilivideo\.(?:cn|net)(?::\d+)?\/.+,REJECT

# ==========================
# PCDN
# ==========================

# HTTPDNS（IP直连）
URL-REGEX,^https?://([0-9][0-9]?[0-9]?\.){3}[0-9][0-9]?[0-9]?(:[0-9]+)?/[0-9]+/resolve\?host=,REJECT

# PCDN 调度
DOMAIN-KEYWORD,pcdn.biliapi.net,REJECT
DOMAIN-KEYWORD,hw-sh-pcdn,REJECT
DOMAIN-KEYWORD,ali-bj-pcdn,REJECT

# 域名:4480
URL-REGEX,^https?:\/\/[^\/]+:4480\/upgcxcode\/.+,REJECT

# IP:8000/8082（v1/resource）
URL-REGEX,^https?:\/\/([0-9][0-9]?[0-9]?\.){3}[0-9][0-9]?[0-9]?:(?:8000|8082)\/v1\/resource\/.+,REJECT

# IP:任意端口（upgcxcode）
URL-REGEX,^https?:\/\/([0-9][0-9]?[0-9]?\.){3}[0-9][0-9]?[0-9]?:[0-9]+\/upgcxcode\/.+,REJECT

# szbdyd
URL-REGEX,^https?:\/\/[a-zA-Z0-9.-]+\.szbdyd\.com(?::\d+)?\/.+,REJECT

# mountaintoys
URL-REGEX,^https?:\/\/[a-zA-Z0-9-]+\.edge\.mountaintoys\.cn(?::(?:4483|9102))?\/upgcxcode\/.+,REJECT

# nexusedgeio
URL-REGEX,^https?:\/\/[a-zA-Z0-9.-]+\.nexusedgeio\.com\/upgcxcode\/.+,REJECT

# ahdohpiechei
URL-REGEX,^https?:\/\/[a-zA-Z0-9.-]+\.ahdohpiechei\.com\/upgcxcode\/.+,REJECT

# yirujs
URL-REGEX,^https?:\/\/[a-zA-Z0-9-]+\.yirujs\.com\/upgcxcode\/.+,REJECT

[URL Rewrite]

# ==========================
# CDN
# ==========================

# Akamai
^https?:\/\/upos-(?:hz|bstar1)-mirrorakam\.akamaized\.net\/upgcxcode\/(.+) http://upos-sz-mirrorcos.bilivideo.com/upgcxcode/$1 302

# mirror14b
^https?:\/\/upos-sz-mirror14b\.bilivideo\.(?:com|cn)\/upgcxcode\/(.+) http://upos-sz-mirrorcos.bilivideo.com/upgcxcode/$1 302

# cn-* 节点
^https?:\/\/cn-[a-zA-Z0-9.-]+\.bilivideo\.(?:com|cn)\/upgcxcode\/(.+) http://upos-sz-mirrorcos.bilivideo.com/upgcxcode/$1 302

# 302kodo
^https?:\/\/upos-sz-302kodo\.bilivideo\.(?:com|cn)\/upgcxcode\/(.+) http://upos-sz-mirrorcos.bilivideo.com/upgcxcode/$1 302

# 302ppio
^https?:\/\/upos-sz-302ppio\.bilivideo\.(?:com|cn)\/upgcxcode\/(.+) http://upos-sz-mirrorcos.bilivideo.com/upgcxcode/$1 302

[MITM]
hostname = %APPEND% *.bilivideo.com, *.bilivideo.cn, upos-*-mirrorakam.akamaized.net
