# ==========================================
# 网易云音乐 Surge/Loon 规则集成配置
# 包含: UnblockNeteaseMusic (UBNM) 核心解锁、VIP 破解、界面精简与去广告
# 兼容: xeapi, eapi, weapi, api 以及各类分发域名
# ==========================================

# ==========================================
# 第一类：UnblockNeteaseMusic (UBNM) 核心解锁规则
# 涉及网易云的歌单、歌曲详情、音源替换等核心 API
# ==========================================
URL-REGEX,^https?://(?:(?:ipv4|interface\d?|interfacepc|apm\d?)\.music\.163\.com|music\.163\.com|interface\d?\.music\.163\.com\.163jiasu\.com)/(?:x?eapi|weapi|api)/(?:v3/playlist/detail|v3/song/detail|v6/playlist/detail|album/play|artist/privilege|album/privilege|v1/artist(?:/songs)?|v2/artist/songs|artist/top/song|v1/album|album/v3/detail|playlist/privilege|song/enhance/player/url(?:/v1)?|song/enhance/download/url(?:/v1)?|song/enhance/privilege|ad|listen/together/privilege/get|playmode/intelligence/list|v1/search/get|v1/search/song/get|search/complex/get|search/complex/page|search/pc/complex/get|search/pc/complex/page|search/song/list/page|search/song/page|cloudsearch/pc|v1/playlist/manipulate/tracks|song/like|radio/like|v1/play/record|playlist/v4/detail|v1/radio/get|v1/discovery/recommend/songs|usertool/sound/mobile/(?:promote|theme|animationList|all|detail)|vipauth/app/auth/query|music-vip-membership/client/vip/info)(?:/\d*)?(?:\?.*)?$

# ==========================================
# 第二类：UBNM 特殊请求规则（Batch / Linux / Package）
# 涉及批处理请求、Linux API 转发和下载/缓存功能
# ==========================================
# UBNM: Batch 批处理接口
URL-REGEX,^https?://(?:(?:ipv4|interface\d?|interfacepc|apm\d?)\.music\.163\.com|music\.163\.com|interface\d?\.music\.163\.com\.163jiasu\.com)/(?:x?eapi|weapi|api)/(?:batch|api/batch)(?:/\d*)?(?:\?.*)?$

# UBNM: Linux API (固定走 /api/linux/forward)
URL-REGEX,^https?://(?:(?:ipv4|interface\d?|interfacepc|apm\d?)\.music\.163\.com|music\.163\.com|interface\d?\.music\.163\.com\.163jiasu\.com)/api/linux/forward(?:\?.*)?$

# UBNM: Package (音源下载缓存, 不带 api 前缀, host为用户自定义endpoint)
URL-REGEX,^https?://(?:[^/]+\.)?music\.163\.com/package/[^/]+/[^/]+\.[^/?]+(?:\?.*)?$

# ==========================================
# 第三类：网易云 VIP 破解/辅助脚本类
# 用于解锁会员歌曲、VIP 皮肤、会员身份展示等
# ==========================================
# 播放会员歌曲相关
URL-REGEX,^https?://(?:(?:ipv4|interface\d?|interfacepc|apm\d?)\.music\.163\.com|music\.163\.com|interface\d?\.music\.163\.com\.163jiasu\.com)/(?:x?eapi|weapi|api)/(?:v1/artist/top/song|v3/discovery/recommend/songs|v3/song/detail|song/(?:chorus|enhance/|play/|type/detail/get))(?:\?.*)?$

# 播放器会员皮肤
URL-REGEX,^https?://(?:(?:ipv4|interface\d?|interfacepc|apm\d?)\.music\.163\.com|music\.163\.com|interface\d?\.music\.163\.com\.163jiasu\.com)/(?:x?eapi|weapi|api)/playermode/(?:\?.*)?$

# 搜索结果会员歌曲
URL-REGEX,^https?://(?:(?:ipv4|interface\d?|interfacepc|apm\d?)\.music\.163\.com|music\.163\.com|interface\d?\.music\.163\.com\.163jiasu\.com)/(?:x?eapi|weapi|api)/search/(?:complex/page|complex/rec/song/get|song/list/page)(?:\?.*)?$

# 侧边栏会员等级 & 会员认证
URL-REGEX,^https?://(?:(?:ipv4|interface\d?|interfacepc|apm\d?)\.music\.163\.com|music\.163\.com|interface\d?\.music\.163\.com\.163jiasu\.com)/(?:x?eapi|weapi|api)/(?:vipnewcenter/app/resource/newaccountpage|vipauth/app/auth/(?:soundquality/)?query)(?:\?.*)?$

# 歌单列表会员认证
URL-REGEX,^https?://(?:(?:ipv4|interface\d?|interfacepc|apm\d?)\.music\.163\.com|music\.163\.com|interface\d?\.music\.163\.com\.163jiasu\.com)/(?:x?eapi|weapi|api)/(?:homepage/|v6/)?playlist/(?!delete|subscribe|unsubscribe).*(?:\?.*)?$

# ==========================================
# 第四类：网易云 界面精简与去广告类
# 屏蔽主页广告、评论区热推、底部 Tab 多余项等
# ==========================================
# 评论区去广告 (包含 batch 和 comment/floor)
URL-REGEX,^https?://(?:(?:ipv4|interface\d?|interfacepc|apm\d?)\.music\.163\.com|music\.163\.com|interface\d?\.music\.163\.com\.163jiasu\.com)/(?:x?eapi|weapi|api)/(?:batch|v2/resource/comment/floor/get)(?:\?.*)?$

# 推荐、主页精简
URL-REGEX,^https?://(?:(?:ipv4|interface\d?|interfacepc|apm\d?)\.music\.163\.com|music\.163\.com|interface\d?\.music\.163\.com\.163jiasu\.com)/(?:x?eapi|weapi|api)/(?:homepage/block/page|link/page/rcmd/(?:block/resource/multi/refresh|resource/show))(?:\?.*)?$

# 底部Tab、发现页、我的页面精简
URL-REGEX,^https?://(?:(?:ipv4|interface\d?|interfacepc|apm\d?)\.music\.163\.com|music\.163\.com|interface\d?\.music\.163\.com\.163jiasu\.com)/(?:x?eapi|weapi|api)/(?:link/home/framework/tab|link/page/discovery/resource/show|link/position/show/resource)(?:\?.*)?$

# 显示未关注你的人
URL-REGEX,^https?://(?:(?:ipv4|interface\d?|interfacepc|apm\d?)\.music\.163\.com|music\.163\.com|interface\d?\.music\.163\.com\.163jiasu\.com)/(?:x?eapi|weapi|api)/user/follow/users/mixed/get(?:\?.*)?$
