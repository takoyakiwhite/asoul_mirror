# ==========================================
# UnblockNeteaseMusic
# Surge Rules
# Based on hook.js
#
# hook.target.host : 8
# hook.target.path : 45
# ==========================================


# ==========================================
# WebAPI / weapi
#
# hook.js:
# /weapi/xxx
#   ↓
# /api/xxx
#
# 同时兼容 hook.js 会移除的末尾 /数字
# ==========================================

URL-REGEX,^https://(?:music\.163\.com|(?:interface|interface3|interfacepc|apm|apm3)\.music\.163\.com|interface\.music\.163\.com\.163jiasu\.com|interface3\.music\.163\.com\.163jiasu\.com)/weapi/(?:v3/playlist/detail|v3/song/detail|v6/playlist/detail|album/play|artist/privilege|album/privilege|v1/artist|v1/artist/songs|v2/artist/songs|artist/top/song|v1/album|album/v3/detail|playlist/privilege|song/enhance/player/url|song/enhance/player/url/v1|song/enhance/download/url|song/enhance/download/url/v1|song/enhance/privilege|ad|listen/together/privilege/get|playmode/intelligence/list|v1/search/get|v1/search/song/get|search/complex/get|search/complex/page|search/pc/complex/get|search/pc/complex/page|search/song/list/page|search/song/page|cloudsearch/pc|v1/playlist/manipulate/tracks|song/like|v1/play/record|playlist/v4/detail|v1/radio/get|v1/discovery/recommend/songs|usertool/sound/mobile/promote|usertool/sound/mobile/theme|usertool/sound/mobile/animationList|usertool/sound/mobile/all|usertool/sound/mobile/detail|vipauth/app/auth/query|music-vip-membership/client/vip/info)(?:/\d*)?(?:\?.*)?$,UnblockNeteaseMusic


# ==========================================
# API
#
# hook.js:
# /api/xxx
#   ↓
# netease.path = url.path
#
# 然后移除末尾 /数字
# ==========================================

URL-REGEX,^https://(?:music\.163\.com|(?:interface|interface3|interfacepc|apm|apm3)\.music\.163\.com|interface\.music\.163\.com\.163jiasu\.com|interface3\.music\.163\.com\.163jiasu\.com)/api/(?:v3/playlist/detail|v3/song/detail|v6/playlist/detail|album/play|artist/privilege|album/privilege|v1/artist|v1/artist/songs|v2/artist/songs|artist/top/song|v1/album|album/v3/detail|playlist/privilege|song/enhance/player/url|song/enhance/player/url/v1|song/enhance/download/url|song/enhance/download/url/v1|song/enhance/privilege|ad|listen/together/privilege/get|playmode/intelligence/list|v1/search/get|v1/search/song/get|search/complex/get|search/complex/page|search/pc/complex/get|search/pc/complex/page|search/song/list/page|search/song/page|cloudsearch/pc|v1/playlist/manipulate/tracks|song/like|v1/play/record|playlist/v4/detail|v1/radio/get|v1/discovery/recommend/songs|usertool/sound/mobile/promote|usertool/sound/mobile/theme|usertool/sound/mobile/animationList|usertool/sound/mobile/all|usertool/sound/mobile/detail|vipauth/app/auth/query|music-vip-membership/client/vip/info)(?:/\d*)?(?:\?.*)?$,UnblockNeteaseMusic


# ==========================================
# EAPI
#
# hook.js:
# /eapi/*
#   ↓
# EAPI 解密 POST Body
#   ↓
# data[0] = netease.path
#   ↓
# 移除末尾 /数字
#   ↓
# hook.target.path.has(netease.path)
#
# URL 层面精确对应 45 个 target path
# ==========================================

URL-REGEX,^https://(?:music\.163\.com|(?:interface|interface3|interfacepc|apm|apm3)\.music\.163\.com|interface\.music\.163\.com\.163jiasu\.com|interface3\.music\.163\.com\.163jiasu\.com)/eapi/(?:v3/playlist/detail|v3/song/detail|v6/playlist/detail|album/play|artist/privilege|album/privilege|v1/artist|v1/artist/songs|v2/artist/songs|artist/top/song|v1/album|album/v3/detail|playlist/privilege|song/enhance/player/url|song/enhance/player/url/v1|song/enhance/download/url|song/enhance/download/url/v1|song/enhance/privilege|ad|listen/together/privilege/get|playmode/intelligence/list|v1/search/get|v1/search/song/get|search/complex/get|search/complex/page|search/pc/complex/get|search/pc/complex/page|search/song/list/page|search/song/page|cloudsearch/pc|v1/playlist/manipulate/tracks|song/like|v1/play/record|playlist/v4/detail|v1/radio/get|v1/discovery/recommend/songs|usertool/sound/mobile/promote|usertool/sound/mobile/theme|usertool/sound/mobile/animationList|usertool/sound/mobile/all|usertool/sound/mobile/detail|vipauth/app/auth/query|music-vip-membership/client/vip/info)(?:/\d*)?(?:\?.*)?$,UnblockNeteaseMusic


# ==========================================
# EAPI / Batch
#
# hook.target.path:
# /batch
# /api/batch
#
# EAPI 请求入口可能对应：
# /eapi/batch
# /eapi/api/batch
# ==========================================

URL-REGEX,^https://(?:music\.163\.com|(?:interface|interface3|interfacepc|apm|apm3)\.music\.163\.com|interface\.music\.163\.com\.163jiasu\.com|interface3\.music\.163\.com\.163jiasu\.com)/eapi/(?:batch|api/batch)(?:/\d*)?(?:\?.*)?$,UnblockNeteaseMusic


# ==========================================
# Batch / WebAPI / API
#
# hook.target.path:
# /batch
# /api/batch
# ==========================================

URL-REGEX,^https://(?:music\.163\.com|(?:interface|interface3|interfacepc|apm|apm3)\.music\.163\.com|interface\.music\.163\.com\.163jiasu\.com|interface3\.music\.163\.com\.163jiasu\.com)/(?:batch|api/batch|weapi/batch)(?:/\d*)?(?:\?.*)?$,UnblockNeteaseMusic


# ==========================================
# LinuxAPI
#
# hook.js 明确处理：
# /api/linux/forward
#
# 这是独立的 linuxapi 加密入口，
# 不属于 45 个 hook.target.path
# ==========================================

URL-REGEX,^https://(?:music\.163\.com|(?:interface|interface3|interfacepc|apm|apm3)\.music\.163\.com|interface\.music\.163\.com\.163jiasu\.com|interface3\.music\.163\.com\.163jiasu\.com)/api/linux/forward(?:\?.*)?$,UnblockNeteaseMusic


# ==========================================
# Package
#
# hook.js:
# req.url.includes('package')
#
# 实际格式：
# /package/<Base64(song.url)>/<id>.<type>
#
# 注意：
# package 的 hostname 不是 hook.target.host 的限制条件。
# hook.js 本身只检查 URL 是否包含 package。
# ==========================================

URL-REGEX,^https?://[^/]+/package/[^/?#]+/[^/?#]+\.[A-Za-z0-9]+(?:\?.*)?$,UnblockNeteaseMusic
