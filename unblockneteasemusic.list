# ==========================================
# UnblockNeteaseMusic
# Surge Rules
# Based on hook(3).js
# ==========================================


# ==========================================
# WebAPI / API
# /weapi/* 会被 hook.js 转换为 /api/*
# ==========================================

URL-REGEX,^https://(?:music|interface|interface3|interfacepc|apm|apm3)\.music\.163\.com/(?:weapi|api)/(?:v3/playlist/detail|v3/song/detail|v6/playlist/detail|album/play|artist/privilege|album/privilege|v1/artist|v1/artist/songs|v2/artist/songs|artist/top/song|v1/album|album/v3/detail|playlist/privilege|song/enhance/player/url|song/enhance/player/url/v1|song/enhance/download/url|song/enhance/download/url/v1|song/enhance/privilege|ad|listen/together/privilege/get|playmode/intelligence/list|v1/search/get|v1/search/song/get|search/complex/get|search/complex/page|search/pc/complex/get|search/pc/complex/page|search/song/list/page|search/song/page|cloudsearch/pc|v1/playlist/manipulate/tracks|song/like|v1/play/record|playlist/v4/detail|v1/radio/get|v1/discovery/recommend/songs|usertool/sound/mobile/promote|usertool/sound/mobile/theme|usertool/sound/mobile/animationList|usertool/sound/mobile/all|usertool/sound/mobile/detail|vipauth/app/auth/query|music-vip-membership/client/vip/info),UnblockNeteaseMusic


# ==========================================
# 163jiasu.com
# WebAPI / API
# ==========================================

URL-REGEX,^https://interface\.music\.163\.com\.163jiasu\.com/(?:weapi|api)/(?:v3/playlist/detail|v3/song/detail|v6/playlist/detail|album/play|artist/privilege|album/privilege|v1/artist|v1/artist/songs|v2/artist/songs|artist/top/song|v1/album|album/v3/detail|playlist/privilege|song/enhance/player/url|song/enhance/player/url/v1|song/enhance/download/url|song/enhance/download/url/v1|song/enhance/privilege|ad|listen/together/privilege/get|playmode/intelligence/list|v1/search/get|v1/search/song/get|search/complex/get|search/complex/page|search/pc/complex/get|search/pc/complex/page|search/song/list/page|search/song/page|cloudsearch/pc|v1/playlist/manipulate/tracks|song/like|v1/play/record|playlist/v4/detail|v1/radio/get|v1/discovery/recommend/songs|usertool/sound/mobile/promote|usertool/sound/mobile/theme|usertool/sound/mobile/animationList|usertool/sound/mobile/all|usertool/sound/mobile/detail|vipauth/app/auth/query|music-vip-membership/client/vip/info),UnblockNeteaseMusic

URL-REGEX,^https://interface3\.music\.163\.com\.163jiasu\.com/(?:weapi|api)/(?:v3/playlist/detail|v3/song/detail|v6/playlist/detail|album/play|artist/privilege|album/privilege|v1/artist|v1/artist/songs|v2/artist/songs|artist/top/song|v1/album|album/v3/detail|playlist/privilege|song/enhance/player/url|song/enhance/player/url/v1|song/enhance/download/url|song/enhance/download/url/v1|song/enhance/privilege|ad|listen/together/privilege/get|playmode/intelligence/list|v1/search/get|v1/search/song/get|search/complex/get|search/complex/page|search/pc/complex/get|search/pc/complex/page|search/song/list/page|search/song/page|cloudsearch/pc|v1/playlist/manipulate/tracks|song/like|v1/play/record|playlist/v4/detail|v1/radio/get|v1/discovery/recommend/songs|usertool/sound/mobile/promote|usertool/sound/mobile/animationList|usertool/sound/mobile/all|usertool/sound/mobile/detail|vipauth/app/auth/query|music-vip-membership/client/vip/info),UnblockNeteaseMusic


# ==========================================
# EAPI
#
# hook.js 会先解密 /eapi/ 请求，
# 再从请求体取得真正的 netease.path
# ==========================================

URL-REGEX,^https://(?:music|interface|interface3|interfacepc|apm|apm3)\.music\.163\.com/eapi/,UnblockNeteaseMusic

URL-REGEX,^https://interface\.music\.163\.com\.163jiasu\.com/eapi/,UnblockNeteaseMusic

URL-REGEX,^https://interface3\.music\.163\.com\.163jiasu\.com/eapi/,UnblockNeteaseMusic


# ==========================================
# LinuxAPI
# ==========================================

URL-REGEX,^https://(?:music|interface|interface3|interfacepc|apm|apm3)\.music\.163\.com/api/linux/forward,UnblockNeteaseMusic

URL-REGEX,^https://interface\.music\.163\.com\.163jiasu\.com/api/linux/forward,UnblockNeteaseMusic

URL-REGEX,^https://interface3\.music\.163\.com\.163jiasu\.com/api/linux/forward,UnblockNeteaseMusic


# ==========================================
# Batch
# ==========================================

URL-REGEX,^https://(?:music|interface|interface3|interfacepc|apm|apm3)\.music\.163\.com/batch,UnblockNeteaseMusic

URL-REGEX,^https://(?:music|interface|interface3|interfacepc|apm|apm3)\.music\.163\.com/api/batch,UnblockNeteaseMusic

URL-REGEX,^https://interface\.music\.163\.com\.163jiasu\.com/(?:batch|api/batch),UnblockNeteaseMusic

URL-REGEX,^https://interface3\.music\.163\.com\.163jiasu\.com/(?:batch|api/batch),UnblockNeteaseMusic


# ==========================================
# Package
# hook.js: req.url.includes('package')
# ==========================================

URL-REGEX,^https?://music\.163\.com/package/[^/]+/[^/]+\.\w+$,UnblockNeteaseMusic
