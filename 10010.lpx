#!name=中国联通 WiFi 通话白名单绕过
#!desc=拦截联通官方白名单接口并修改响应体：0211 -> 0000
#!author=takoyakiwhite
#!icon=https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1010.png

[Rewrite]
^https:\/\/m\.client\.10010\.com\/edopinterface\/officialWhite\/checkOfficialWhitePhone response-body-json-jq '.response.head.respCode = "0000" | .response.head.respMsg = "Success" | .response.body = {}'

[MITM]
hostname = m.client.10010.com
