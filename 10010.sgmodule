#!name=中国联通 WiFi 通话白名单绕过
#!desc=拦截联通官方白名单接口并修改响应体：0211 -> 0000
#!author=takoyakiwhite

[Body Rewrite]
http-response-jq ^https:\/\/m\.client\.10010\.com\/edopinterface\/officialWhite\/checkOfficialWhitePhone '.response.head.respCode = "0000" | .response.head.respMsg = "Success" | .response.body = {}'

[MITM]
hostname = %APPEND% m.client.10010.com
